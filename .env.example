# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000

# Database Configuration (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/lennys_growth_db

# Default LLM Provider Selection (ollama | openai)
DEFAULT_LLM_PROVIDER=ollama
AUTO_FALLBACK_TO_CLOUD=false

# Local Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# OpenAI Cloud Provider Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Anthropic Cloud Provider Configuration (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
